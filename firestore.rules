rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: is creator (simple check, for robust solution we might use a collection)
    function isCreator() {
      return request.auth != null && request.auth.token.email == 'baralshruti24@gmail.com';
    }

    match /creatorRecordings/{recordingId} {
      allow read: if true;
       allow create: if isCreator();
      allow update: if isCreator();
      allow delete: if isCreator();
    }
  }
}
